# Maintainer: Daniel <danielgarcarrasco at gmail dot com>

pkgname=omaread-git
pkgver=1.0.0.r46.ge5928f0
pkgrel=1
pkgdesc="An EPUB, AZW3 and MOBI reader for Wayland, made for Omarchy"
arch=('x86_64' 'aarch64')
url="https://github.com/danielgccr/omaread"
license=('GPL-3.0-or-later')
# fontconfig, wayland and libxkbcommon are dlopened at run time, not linked.
depends=('fontconfig' 'gcc-libs' 'glibc' 'libxkbcommon' 'wayland')
makedepends=('cargo' 'git')
optdepends=('xdg-desktop-portal: file and folder pickers, show in folder, trash'
            'wl-clipboard: copy selected text'
            'xdg-utils: open external links')
provides=('omaread')
conflicts=('omaread')
source=("git+$url.git")
sha256sums=('SKIP')
# makepkg's LTO turns the bundled SQLite into GCC bitcode, which the Rust link
# step cannot read: undefined sqlite3_* symbols.
options=('!lto')

pkgver() {
  cd omaread
  printf "%s.r%s.g%s" \
    "$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -1)" \
    "$(git rev-list --count HEAD)" \
    "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd omaread
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd omaread
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd omaread
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo test --frozen --release
}

package() {
  cd omaread
  install -Dm755 target/release/omaread -t "$pkgdir/usr/bin"
  install -Dm644 assets/omaread.desktop -t "$pkgdir/usr/share/applications"
  install -Dm644 assets/omarchy/omaread.css.tpl assets/omarchy/omaread.lua \
    -t "$pkgdir/usr/share/omaread/omarchy"
  install -Dm644 README.md -t "$pkgdir/usr/share/doc/$pkgname"
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
  install -Dm644 assets/fonts/*-OFL.txt -t "$pkgdir/usr/share/licenses/$pkgname"
}
